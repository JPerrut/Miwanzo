{
  "name": "miwanzo-workspace",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev:db": "concurrently \"npm run dev:frontend\" \"npm run db:setup && npm run dev:backend\"",
    "build:frontend": "npm --prefix frontend run build",
    "lint:frontend": "npm --prefix frontend run lint",
    "preview:frontend": "npm --prefix frontend run preview",
    "test:backend": "npm --prefix backend run test",
    "lint:backend": "npm --prefix backend run lint",
    "db:setup": "npm --prefix backend run db:setup",
    "db:reset": "npm --prefix backend run db:reset",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:studio": "npm --prefix backend run db:studio",
    "install:all": "npm install && npm --prefix frontend install && npm --prefix backend install",
    "setup": "npm install && npm --prefix frontend install && npm --prefix backend install && npm run db:setup"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
